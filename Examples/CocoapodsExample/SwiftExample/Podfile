
platform :ios, '15.0'

target 'GeofenceSwiftPodsExample' do

  use_frameworks!

  pod 'CleverTap-iOS-SDK', :git => 'https://github.com/CleverTap/clevertap-ios-sdk.git'
  pod 'CleverTap-Geofence-SDK', :path => '../../../'

  target 'GeofenceSwiftPodsExampleTests' do
    inherit! :search_paths

  end

  target 'GeofenceSwiftPodsExampleUITests' do

  end

end

# Xcode 27 refuses to build any target below iOS 15, including transitive pods
# such as SDWebImage that still declare an older minimum of their own.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
